# Imagem do "Portal de Relatorios" (relat.lima.rio.br).
# Espelha o Dockerfile do app geo (node build -> nginx), mas builda o segundo
# app Vite (apps/relat) e NAO injeta VITE_API_BASE_URL: o relat e servido
# same-origin (relat.lima.rio.br/api e roteado pelo Caddy para o mesmo backend),
# entao serviceFactory deriva ${window.location.origin}/api em runtime.
FROM node:20-alpine@sha256:b88333c42c23fbd91596ebd7fd10de239cedab9617de04142dde7315e3bc0afa AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build:relat

FROM nginx:stable-alpine@sha256:5b4900b042ccfa8b0a73df622c3a60f2322faeb2be800cbee5aa7b44d241649e AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/relat/dist /usr/share/nginx/html

RUN mkdir -p /var/cache/nginx/client_temp /var/run/nginx \
  && sed -i -E 's#^pid\s+[^;]+;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
  && chown -R nginx:nginx /var/cache/nginx /var/run/nginx /var/log/nginx /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

USER nginx

CMD ["nginx", "-g", "daemon off;"]
