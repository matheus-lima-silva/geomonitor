# Caddy termina TLS para os dominios amigaveis (geo.lima.rio.br, futuramente
# relat.lima.rio.br) usando certs Let's Encrypt emitidos via desafio ACME DNS-01
# pelo plugin caddy-dns/cloudflare. Os nomes resolvem (registros DNS-only no
# Cloudflare) para o IP Tailscale 100.x da VM, entao so conectam dentro da tailnet.
# O `tailscale serve` foi desativado; o Caddy escuta 80/443 na interface Tailscale.

{
	email {$ACME_EMAIL}
	# DNS-01 e obrigatorio: o IP de destino e tailnet-only, entao HTTP-01/TLS-ALPN
	# nao alcancam o host. O token Cloudflare precisa de escopo Zone:DNS:Edit.
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Roteamento de um app do monorepo, reutilizavel por hostname.
# Recebe o upstream do SPA como argumento: `import app_routes <web|relat>`.
# /api, /health e a rota do MinIO sao compartilhados (mesmo backend) — e isso
# que da ao relat o mesmo-origem (relat.lima.rio.br/api -> api:8080).
(app_routes) {
	# /api/* -> backend Node. Usa `handle` (nao `handle_path`) para preservar o
	# prefixo /api que o Express espera nos mounts (app.use('/api/...', router)).
	handle /api/* {
		reverse_proxy api:8080
	}

	# Endpoint /health do backend (sem prefixo /api) para healthcheck simples.
	handle /health {
		reverse_proxy api:8080
	}

	# Signed URLs do MinIO vem como /<BUCKET_NAME>/<key>?<assinatura>.
	# Caddy roteia direto para o MinIO. IMPORTANTE: o backend assina a URL com
	# `Host: minio:9000` (endpoint interno do SDK) e o Caddy 2 preserva o Host
	# original do cliente por default. Precisamos reescrever Host=minio:9000 no
	# upstream pra signature S3 bater. Sem isso: SignatureDoesNotMatch (403).
	handle /{$BUCKET_NAME}/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			# O SPA roda no mesmo origem das signed URLs (graças ao MEDIA_PUBLIC_ENDPOINT),
			# entao o fetch dele anexa Authorization: Bearer <JWT> em toda request. O MinIO
			# ve esse header e interpreta como SigV4 via header (em vez de presigned via QS),
			# tenta validar o JWT como assinatura S3 e rejeita com SignatureDoesNotMatch (400).
			# A autenticacao real esta na query string (X-Amz-Signature) — strip aqui.
			header_up -Authorization
		}
	}

	# Tudo o mais cai no SPA do app indicado (nginx servindo dist/).
	handle {
		reverse_proxy {args[0]}:8080
	}

	# Logs JSON estruturados; util pra debug com docker compose logs caddy.
	log {
		output stdout
		format json
	}
}

# App principal. TLS via DNS-01 (config global acima).
{$GEO_HOSTNAME} {
	import app_routes web
}

# Healthcheck interno do CI/CD (curl http://127.0.0.1:8080/health na VM).
# Plain HTTP em 127.0.0.1:8080; nao emite cert.
:8080 {
	handle /health {
		reverse_proxy api:8080
	}
}

# Portal de Relatorios: relat.lima.rio.br -> container `relat` (segundo SPA),
# compartilhando /api + /health + MinIO com o geo (mesmo-origem).
# Quando RELAT_HOSTNAME nao esta setado no .env, o compose injeta o default
# seguro `relat.localhost` (cert interno do Caddy, sem ACME) — assim subir o
# stack sem configurar o relat NAO derruba o geo. Para ativar de verdade:
# setar RELAT_HOSTNAME=relat.lima.rio.br no .env + registro DNS-only no Cloudflare.
{$RELAT_HOSTNAME} {
	import app_routes relat
}
