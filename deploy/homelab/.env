# GeoMonitor — variaveis de ambiente para o stack homelab.
#
# ESTE ARQUIVO E UM TEMPLATE VERSIONADO COM PLACEHOLDERS.
# Apos clonar na VM, edite-o com valores reais e desligue o tracking de
# mudancas para nao commitar segredos por engano:
#
#   git update-index --skip-worktree deploy/homelab/.env
#
# Pra reativar (ex.: pra atualizar o template): git update-index --no-skip-worktree.
# NUNCA commite este arquivo com valores reais.

# ============================================================================
# Hostnames / URLs publicas
# ============================================================================
# Nome MagicDNS da VM na sua tailnet (ex.: geomonitor.tail-abc1.ts.net).
# Eh o hostname que o tailscale serve vai expor com TLS.
PUBLIC_HOSTNAME=geomonitor.tail-xxxx.ts.net

# URL completa (com https://) usada para montar links HATEOAS e signed URLs.
# Normalmente eh https://<PUBLIC_HOSTNAME>.
PUBLIC_BASE_URL=https://geomonitor.tail-xxxx.ts.net

# ============================================================================
# Postgres
# ============================================================================
POSTGRES_USER=geomonitor
POSTGRES_PASSWORD=trocar-por-senha-forte
POSTGRES_DB=geomonitor
DATABASE_URL=postgres://geomonitor:trocar-por-senha-forte@postgres:5432/geomonitor

# ============================================================================
# MinIO (storage S3-compatible)
# ============================================================================
MINIO_ROOT_USER=geomonitor
MINIO_ROOT_PASSWORD=trocar-por-senha-forte-min-8-chars
BUCKET_NAME=geomonitor-media

# Credenciais usadas pelo backend para falar com o MinIO.
# Em producao, criar um service account dedicado no MinIO em vez de usar root.
AWS_ACCESS_KEY_ID=geomonitor
AWS_SECRET_ACCESS_KEY=trocar-por-senha-forte-min-8-chars

# Endpoint publico usado para reescrever signed URLs (ver mediaStorage.js).
# Aponta para o Caddy externo; o caminho /<BUCKET_NAME>/* eh roteado para o MinIO interno.
MEDIA_PUBLIC_ENDPOINT=https://geomonitor.tail-xxxx.ts.net

# ============================================================================
# API (backend)
# ============================================================================
# Base URL canonica devolvida nos links HATEOAS.
API_BASE_URL=https://geomonitor.tail-xxxx.ts.net/api

# CORS origin permitido. Mesmo dominio da SPA.
FRONTEND_URL=https://geomonitor.tail-xxxx.ts.net

# JWT secret (gerar com: openssl rand -hex 64).
JWT_SECRET=trocar-por-segredo-aleatorio-com-pelo-menos-64-hex

# Refresh token secret (gerar com: openssl rand -hex 64). Pode ser igual ao JWT_SECRET ou diferente.
JWT_REFRESH_SECRET=trocar-por-outro-segredo-aleatorio

# Token que o worker usa no header x-worker-token para chamar rotas privadas.
# Gerar com: openssl rand -hex 32.
WORKER_API_TOKEN=trocar-por-token-aleatorio-32-hex

# Limite de queries por request antes de gravar alerta em system_alerts.
QUERY_COUNT_ALERT_THRESHOLD=15

# ============================================================================
# Worker
# ============================================================================
# Variaveis do worker (Python) ja inline no compose. Aqui so o segredo
# compartilhado com a API.
# WORKER_API_TOKEN ja definido acima.

# ============================================================================
# Frontend (build-args do Vite — bakeados no bundle estatico)
# ============================================================================
# Mantemos a config Firebase atual ate decidir se vamos remover Firebase tambem.
# Copiar valores de deploy/fly/producao/web.toml. Se quiser remover o Firebase
# do bundle, ajustar src/ + remover ARGs.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
